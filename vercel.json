{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:board-demo",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "missing": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "destination": "/?v=board-demo",
      "permanent": false
    }
  ]
}
